# Every variable the app reads, with dummy values. Copy to .env.
# The real production .env lives only on aster at /opt/claude-sync/parks-passport/.env
NODE_ENV=production
# PORT is set by docker-compose.aster.yml (8080)
HOST=0.0.0.0
DATA_DIR=/data
BASE_URL=https://parkspassport.dzuynguyen.com
# Email: "sendgrid" in production; "outbox" writes .eml files to $DATA_DIR/outbox (dev/test)
MAIL_TRANSPORT=sendgrid
SENDGRID_API_KEY=SG.dummy-key-for-example-only
MAIL_FROM=hello@parkspassport.dzuynguyen.com
# Encrypts the SendGrid key saved in Admin › Email. Optional: without it, a random key is
# generated once in $DATA_DIR/settings.key. Changing it makes a saved key unreadable (re-save it).
SETTINGS_KEY=change-me-to-a-long-random-string
# Admin › City theme "Generate with AI" (Claude API, web search). Optional: empty turns the
# button off; the hand-made St. Pete theme still works. Server .env only, never in the repo.
ANTHROPIC_API_KEY=sk-ant-dummy-key
# Home page "you're near Westminster" suggestion (optional; empty = off). A MaxMind
# GeoLite2-City database file inside the data volume; looked up locally, IPs are never sent out.
# Steps: docs/geoip.md. e.g. /data/geoip/GeoLite2-City.mmdb
GEOIP_DB=
# Gary dresses for today's weather (Open-Meteo, free, no key; only a city's center is sent).
# off = Gary always wears the member's pick or Classic.
WEATHER=on
# Analytics (all optional; empty = not loaded).
# Google Tag Manager container; GA4 is configured inside GTM. Loaded behind Consent Mode v2.
# Production sets GTM_ID in docker-compose.aster.yml (GTM-NZFVTGR8). e.g. GTM-ABC1234
GTM_ID=
# Where gtm.js is loaded from. Point at a first-party server-side GTM host later, e.g.
# https://sgtm.parkspassport.dzuynguyen.com (no code change needed).
GTM_SCRIPT_ORIGIN=https://www.googletagmanager.com
# Umami (cookieless), served first-party under /stats/ by nginx. The website id comes from
# the Umami dashboard after adding the site.
# e.g. 0f2c3d4e-1234-4abc-8def-123456789abc
UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=/stats/script.js
UMAMI_HOST_URL=https://parkspassport.dzuynguyen.com/stats
# Umami containers (docker-compose.aster.yml, "analytics" profile). Set all three to start them.
# COMPOSE_PROFILES=analytics
UMAMI_IMAGE=ghcr.io/umami-software/umami:postgresql-latest
UMAMI_DB_PASSWORD=change-me-long-random
UMAMI_APP_SECRET=change-me-long-random
