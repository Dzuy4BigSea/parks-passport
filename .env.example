# Every variable the app reads, with dummy values. Copy to .env.
# The real production .env lives only on aster at /opt/claude-sync/parks-passport/.env
NODE_ENV=production
# PORT is set by docker-compose.aster.yml (8080)
HOST=0.0.0.0
DATA_DIR=/data
BASE_URL=https://parkspassport.dzuynguyen.com
# Email: "sendgrid" in production; "outbox" writes .eml files to $DATA_DIR/outbox (dev/test)
MAIL_TRANSPORT=sendgrid
SENDGRID_API_KEY=SG.dummy-key-for-example-only
MAIL_FROM=hello@parkspassport.dzuynguyen.com
# Encrypts the SendGrid key saved in Admin › Email. Optional: without it, a random key is
# generated once in $DATA_DIR/settings.key. Changing it makes a saved key unreadable (re-save it).
SETTINGS_KEY=change-me-to-a-long-random-string
